void __va_start(__va_list_struct *ap, void *fp)
{
    __va_list_struct *src;
    memset(ap, 0, sizeof(__va_list_struct));
    src = (__va_list_struct *)((char *)fp - 16);
    ap->gp_offset = src->gp_offset;
    ap->fp_offset = src->fp_offset;
    ap->overflow_offset = src->overflow_offset;
    ap->reg_save_area = src->reg_save_area;
    ap->overflow_arg_area = (char *)fp + ap->overflow_offset;
    ap->reg_save_area = (char *)fp - 176 - 16;
}

void *__va_arg(__va_list_struct *ap,
               int arg_type,
               int size, int align)
